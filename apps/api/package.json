{
  "name": "@outscan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @outscan/capabilities build",
    "dev": "tsx watch src/server.ts",
    "dev:retention": "tsx src/guest-retention-cli.ts",
    "dev:scanner": "tsx src/guest-scanner-cli.ts",
    "dev:worker": "tsx src/guest-worker-cli.ts",
    "prebuild": "pnpm --filter @outscan/capabilities build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:retention": "node dist/guest-retention-cli.js",
    "start:scanner": "node dist/guest-scanner-cli.js",
    "start:worker": "node dist/guest-worker-cli.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @outscan/capabilities build",
    "test": "vitest run --exclude \"db-test/**\" --exclude \"queue-test/**\"",
    "test:db": "vitest run db-test --no-file-parallelism --maxWorkers=1",
    "test:queue": "vitest run queue-test --no-file-parallelism --maxWorkers=1",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@outscan/capabilities": "workspace:*",
    "bullmq": "6.3.4",
    "fastify": "5.12.1",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "tldts": "7.4.11"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
