{
  "name": "@outscan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @outscan/capabilities build",
    "dev": "tsx watch src/server.ts",
    "prebuild": "pnpm --filter @outscan/capabilities build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @outscan/capabilities build",
    "test": "vitest run --exclude db-test/**",
    "test:db": "vitest run db-test --no-file-parallelism --maxWorkers=1",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@outscan/capabilities": "workspace:*",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "tldts": "7.4.11"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "vitest": "4.1.11"
  }
}
